# ============================================
# ClawnBoard Configuration
# ============================================

# Fly.io (required)
# Create an org token: fly tokens create org -x 999999h
# Must be an ORG token (not deploy token) to create new apps
FLY_API_TOKEN=FlyV1 paste-your-org-token-here
FLY_REGION=iad

# AI Provider Keys (at least one required)
# These are passed to moltbots so OpenClaw can use AI models
# Anthropic API key: https://console.anthropic.com/settings/keys
# Anthropic Claude subscription (instead of API key): run `claude setup-token`, paste below
#   Docs: https://docs.openclaw.ai/providers/anthropic — do not set ANTHROPIC_API_KEY if you use this
# OPENAI_API_KEY: https://platform.openai.com/api-keys
# OPENROUTER_API_KEY: https://openrouter.ai/keys
ANTHROPIC_API_KEY=
ANTHROPIC_SETUP_TOKEN=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Discord bootstrap for new moltbots
# If set, new moltbots start with channels.discord preconfigured.
DISCORD_BOT_TOKEN=
# Optional guild allowlist target (server ID)
DISCORD_GUILD_ID=
# Optional DM policy (default: pairing)
DISCORD_DM_POLICY=pairing
# Optional mention requirement inside the allowed guild (true/false)
DISCORD_REQUIRE_MENTION=false

# Server
PORT=3001
