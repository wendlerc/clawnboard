# Dockerfile for Moltbot VMs
# Extends the published OpenClaw image with additional tooling.
# Uses :latest - CI workflow has pull: true to always fetch fresh base image.

FROM ghcr.io/openclaw/openclaw:latest

USER root


# Install required packages
RUN apt-get update && apt-get install -y \
    dbus-x11 \
    build-essential \
    ca-certificates \
    chromium \
    curl \
    fonts-liberation \
    gh \
    git \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    golang-go \
    screen \
    sudo \
    x11-utils \
    x11-xserver-utils \
    xauth \
    xdg-utils \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Install additional CLI tooling
RUN git clone https://github.com/ash-openclaw/amail-cli.git /opt/amail-cli \
    && chmod +x /opt/amail-cli/amail \
    && ln -sf /opt/amail-cli/amail /usr/local/bin/amail \
    && GOBIN=/usr/local/bin go install github.com/emersion/hydroxide/cmd/hydroxide@v0.2.29

# Ensure the moltbot user exists and has passwordless sudo.
RUN if ! id -u moltbot >/dev/null 2>&1; then useradd -m -s /bin/bash moltbot; fi \
    && echo "moltbot ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/moltbot \
    && chmod 0440 /etc/sudoers.d/moltbot \
    && if id -u node >/dev/null 2>&1; then \
      echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node \
      && chmod 0440 /etc/sudoers.d/node; \
    fi

ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/.cache/ms-playwright

RUN mkdir -p /home/node/.cache/ms-playwright \
    && chown -R node:node /home/node/.cache

USER node

RUN node /app/node_modules/playwright-core/cli.js install chromium
